{
  "schema": "hex_plot_vertex_graph_contract_v0",
  "purpose": "Connect hex terrain cells into plot-aware shared corner vertices, shared edge midpoints, edge profiles, sockets, and seamless radial top mesh data.",
  "required_fields": [
    "schema",
    "graph_id",
    "source_terrain_assembly",
    "map_cube",
    "hex_grid",
    "corner_vertices",
    "edge_midpoints",
    "hex_plots",
    "edge_summary",
    "delta_band_summary",
    "profile_rule_summary",
    "socket_summary",
    "mesh_plan",
    "validation",
    "no_claims"
  ],
  "hex_plot_fields": [
    "cell_id",
    "q",
    "r",
    "s",
    "center",
    "center_height",
    "plot_role",
    "buildable",
    "corner_vertex_ids",
    "corner_heights",
    "edge_midpoint_ids",
    "edge_midpoint_heights",
    "edge_midpoint_height_bands",
    "edges",
    "sockets",
    "movement_tags",
    "structure_socket_tags"
  ],
  "edge_profile_terms": [
    "flat_join",
    "smooth_slope",
    "hard_step",
    "cliff_drop",
    "chunk_boundary",
    "structure_edge",
    "road_join",
    "building_seam"
  ],
  "connector_terms": [
    "walkable",
    "walkable_with_cost",
    "step_connector",
    "blocked_without_connector",
    "chunk_boundary",
    "structure_socket"
  ],
  "rules": {
    "corner_vertices_are_shared_by_world_xy": true,
    "edge_midpoints_are_shared_by_canonical_edge_key": true,
    "shared_surface_edges_use_same_midpoint_id_on_both_cells": true,
    "split_seams_use_explicit_cell_owned_midpoints": true,
    "cell_corner_and_midpoint_records_expose_height_band_and_height_m": true,
    "edge_records_expose_delta_band_and_transition_class": true,
    "delta_zero_is_shared_flat": true,
    "delta_one_is_soft_fold_or_step": true,
    "delta_two_plus_is_cliff_fault": true,
    "q_plus_r_plus_s_equals_zero": true,
    "each_hex_plot_has_six_corner_vertices": true,
    "each_hex_plot_has_six_edge_midpoints": true,
    "each_hex_plot_has_six_edges": true,
    "top_mesh_uses_twelve_triangles_per_hex": true,
    "cracked_seam_count_must_be_zero": true,
    "shared_corner_height_is_averaged_from_adjacent_cells_v0": true,
    "hard_seams_are_recorded_and_split_with_explicit_seam_facts_v0": true,
    "no_mesh_files": true,
    "no_blender_output": true,
    "no_structural_claims": true,
    "no_production_approval": true
  }
}
