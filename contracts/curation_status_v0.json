{
  "schema": "curation_status_contract_v0",
  "purpose": "Define human or Dex review state for 3D architecture lab workflow artifacts.",
  "required_fields": [
    "schema",
    "artifact_id",
    "job_id",
    "lane",
    "status",
    "reason",
    "reviewed_by",
    "reviewed_at_utc",
    "next_recommended_job",
    "decision_history"
  ],
  "allowed_status": [
    "unreviewed",
    "keep",
    "revise",
    "reject",
    "defer",
    "blocked"
  ],
  "rules": {
    "status_requires_reason": true,
    "unreviewed_is_default": true,
    "review_does_not_claim_production_approval": true,
    "review_does_not_claim_structural_safety": true,
    "review_does_not_claim_fabrication_readiness": true,
    "review_does_not_claim_historical_accuracy": true,
    "review_does_not_claim_game_engine_integration": true,
    "decision_changes_append_history": true,
    "review_must_reference_existing_artifact_manifest": true,
    "review_must_not_reference_pattern_lab_2d": true,
    "review_must_not_reference_mosaic_tile_outputs": true
  }
}
