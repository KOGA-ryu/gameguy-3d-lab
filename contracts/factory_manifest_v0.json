{
  "schema": "factory_manifest_contract_v0",
  "purpose": "Define the top-level procedural factory index that points to lane registries, job roots, artifact roots, curation roots, receipts, reports, and validation commands.",
  "required_fields": [
    "schema",
    "factory_id",
    "version",
    "lane_registry",
    "job_roots",
    "artifact_roots",
    "curation_roots",
    "receipt_root",
    "report_root",
    "validation_commands",
    "no_claims"
  ],
  "rules": {
    "factory_does_not_generate_assets_directly": true,
    "factory_jobs_must_reference_existing_lanes": true,
    "factory_jobs_must_have_inputs_commands_outputs_validation_and_receipt": true,
    "factory_receipts_are_machine_readable": true,
    "factory_reports_are_human_readable": true
  },
  "required_no_claims": {
    "production_approval": false,
    "gym_museum_approval": false,
    "final_asset_claim": false
  }
}
