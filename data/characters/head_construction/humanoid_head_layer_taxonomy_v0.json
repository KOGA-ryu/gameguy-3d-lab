    },
    {
      "contour_role_id": "plane_break_contour",
      "plain_name": "plane break contour",
      "purpose": "Marks transition lines from front face to cheek, jaw, side face, and skull.",
      "compatible_shape_terms": ["plane_break", "chamfer", "bevel"]
    },
    {
      "contour_role_id": "construction_contour",
      "plain_name": "construction contour",
      "purpose": "Guide-only contour used to place landmarks, not necessarily rendered.",
      "compatible_shape_terms": ["plane", "envelope", "wedge", "socket", "ridge"]
    }
  ],
  "build_order_summary": [
    "Block the cranium and occiput first so the head reads as a head before facial detail.",
    "Lay the front face mask planes on top of the skull envelope.",
    "Add the brow and eye sockets before the nose, because the brow establishes facial direction and shadow.",
    "Extrude the nose wedge after the sockets so nose depth is judged against the orbit recess.",
    "Add cheeks, mouth, chin, and jaw as secondary planes and relief.",
    "Apply final bevel/chamfer/normal rules last so edge language is consistent."
  ],
