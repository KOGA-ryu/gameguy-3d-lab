  "facial_parts": [
    {
      "part_id": "cranium",
      "plain_name": "cranium",
      "anatomy_terms": ["cranium", "skull vault"],
      "construction_role": "Largest upper and rear head mass.",
      "read_goal": "Head still reads correctly with all facial detail hidden."
    },
    {
      "part_id": "occiput",
      "plain_name": "back of head",
      "anatomy_terms": ["occiput", "rear skull"],
      "construction_role": "Back-skull profile and rounded rear mass.",
      "read_goal": "Side view does not become a flat mask."
    },
    {
      "part_id": "forehead",
      "plain_name": "forehead plane",
      "anatomy_terms": ["frontal bone", "forehead"],
      "construction_role": "Broad upper face plane above brow.",
      "read_goal": "Creates a calm plane before the brow breaks forward."
    },
    {
      "part_id": "brow_ridge",
      "plain_name": "brow ridge",
      "anatomy_terms": ["supraorbital ridge", "glabella"],
      "construction_role": "Raised ridge that defines the upper eye sockets.",
      "read_goal": "Gives the face shadow and direction without drawing eyes."
    },
    {
      "part_id": "eye_sockets",
      "plain_name": "eye sockets",
      "anatomy_terms": ["orbital sockets", "orbits"],
      "construction_role": "Paired recesses under the brow.",
      "read_goal": "Eyes read as sockets, not painted dots on a flat head."
    },
    {
      "part_id": "nose",
      "plain_name": "nose wedge",
      "anatomy_terms": ["nasal bridge", "nasal tip", "nose base"],
      "construction_role": "Central protruding wedge from sellion to subnasale.",
      "read_goal": "Front and side views immediately reveal head direction."
    },
    {
      "part_id": "cheeks",
      "plain_name": "cheek planes",
      "anatomy_terms": ["zygomatic bones", "midface"],
      "construction_role": "Raised side planes between sockets, nose, mouth, and side face.",
      "read_goal": "Breaks the flat mask and catches light on both sides."
    },
    {
      "part_id": "mouth",
      "plain_name": "mouth and lips",
      "anatomy_terms": ["mouth crease", "upper lip", "lower lip", "philtrum"],
      "construction_role": "Small valley and raised relief below the nose.",
      "read_goal": "Readable expressionless mouth without over-sculpting."
    },
    {
      "part_id": "chin",
      "plain_name": "chin mass",
      "anatomy_terms": ["mental eminence", "chin"],
      "construction_role": "Lower forward protrusion under the mouth.",
      "read_goal": "Lower face has weight instead of ending as a flat slice."
    },
    {
      "part_id": "jaw",
      "plain_name": "jaw and side face",
      "anatomy_terms": ["mandible", "bigonial width", "jaw corner"],
      "construction_role": "Plane break from front face to side face.",
      "read_goal": "Front silhouette, lower face, and side planes align."
    },
    {
      "part_id": "ears",
      "plain_name": "ear anchors",
      "anatomy_terms": ["ear", "auricle"],
      "construction_role": "Optional side anchor and scale reference.",
      "read_goal": "Side of head has attachment landmarks for future hair/helmet work."
    },
    {
      "part_id": "neck_socket",
      "plain_name": "neck socket",
      "anatomy_terms": ["neck attachment", "cervical connection"],
      "construction_role": "Bottom connector into the body mannequin rig.",
      "read_goal": "Head can attach to the existing neck joint without floating."
    }
  ],
  "shape_terms": [
    {
