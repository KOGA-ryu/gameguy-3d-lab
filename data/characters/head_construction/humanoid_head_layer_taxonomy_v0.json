      "blender_tool_ids": ["mesh_from_pydata", "bridge_edge_loops", "modifier_bevel", "modifier_weighted_normal"]
    },
    {
      "shape_term_id": "plane",
      "plain_name": "plane",
      "meaning": "A deliberately flat or broad surface that faces a direction.",
