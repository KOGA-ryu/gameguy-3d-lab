{
  "schema": "humanoid_head_layer_taxonomy_v0",
  "bundle_id": "humanoid_head_layer_taxonomy_v0",
  "purpose": "Define the source-side vocabulary, measurement anchors, construction layers, shape terms, Blender tool mapping, and quality checks for a low-compute humanoid mannequin head before any Blender adapter generates geometry.",
  "rules": {
    "source_recipe_only": true,
    "no_blender_execution": true,
    "largest_forms_first": true,
    "defining_forms_before_detail": true,
    "measurements_anchor_proportions": true,
    "style_parameters_handle_art_direction": true,
    "not_medical_or_safety_guidance": true
  },
  "source_support": [
    {
      "label": "NIOSH CDC Stacks: Head-and-Face Anthropometric Survey of U.S. Respirator Users",
      "url": "https://stacks.cdc.gov/view/cdc/181482",
      "support_summary": "Primary source for measured adult head and face dimensions such as head length, head breadth, cheek width, jaw width, nose dimensions, and lip length."
    },
    {
      "label": "National Academies resource copy of Anthrotech report",
      "url": "https://nap.nationalacademies.org/resource/11815/Anthrotech_report.pdf",
      "support_summary": "Accessible report copy used as the source packet for the NIOSH/Anthrotech head and face measurement table."
    },
    {
      "label": "NASA Anthropometric Source Book",
      "url": "https://ntrs.nasa.gov/search.jsp?R=19790003563",
      "support_summary": "General anthropometry reference for treating body and head dimensions as named measured fields instead of guessed sculpt proportions."
    }
  ],
