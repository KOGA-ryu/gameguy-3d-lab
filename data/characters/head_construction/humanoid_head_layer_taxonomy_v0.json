    },
    {
      "shape_term_id": "socket",
      "plain_name": "socket",
      "meaning": "A controlled depression with a visible rim.",
      "operation_terms": ["offset_profile", "boolean_cut", "bevel_edges"],
      "blender_tool_ids": ["inset_faces", "extrude_faces", "modifier_boolean", "modifier_bevel"]
    },
    {
      "shape_term_id": "wedge",
      "plain_name": "wedge",
      "meaning": "A protruding form with tapering side planes.",
      "operation_terms": ["extrude", "scale_profile", "bevel_edges"],
      "blender_tool_ids": ["mesh_from_pydata", "extrude_faces", "modifier_bevel", "modifier_weighted_normal"]
    },
    {
      "shape_term_id": "valley",
      "plain_name": "valley",
      "meaning": "A narrow recessed groove or crease.",
      "operation_terms": ["boolean_cut", "offset_profile", "bevel_edges"],
      "blender_tool_ids": ["knife_project", "inset_faces", "extrude_faces", "sculpt_crease"]
    },
    {
      "shape_term_id": "relief",
      "plain_name": "relief",
      "meaning": "Small raised surface detail applied on top of a base plane.",
      "operation_terms": ["relief_stack", "extrude", "bevel_edges"],
      "blender_tool_ids": ["mesh_from_pydata", "extrude_faces", "modifier_bevel", "material_assign_by_part"]
    },
    {
      "shape_term_id": "chamfer",
      "plain_name": "chamfer",
      "meaning": "A straight angled edge transition, usually one bevel segment.",
      "operation_terms": ["bevel_edges"],
      "blender_tool_ids": ["bevel_mesh_edges", "modifier_bevel", "modifier_weighted_normal"]
    },
    {
      "shape_term_id": "bevel",
      "plain_name": "bevel",
      "meaning": "A rounded or softened edge transition.",
      "operation_terms": ["bevel_edges"],
      "blender_tool_ids": ["bevel_mesh_edges", "modifier_bevel", "modifier_weighted_normal"]
    }
  ],
  "contour_roles": [
    {
      "contour_role_id": "silhouette_contour",
      "plain_name": "silhouette contour",
      "purpose": "Defines the visible outer boundary of the head from front or side.",
      "compatible_shape_terms": ["envelope", "plane_break", "bevel"]
    },
    {
      "contour_role_id": "profile_contour",
      "plain_name": "profile contour",
      "purpose": "Controls side-view depth for forehead, brow, nose, lips, chin, and back skull.",
      "compatible_shape_terms": ["envelope", "wedge", "plane_break", "chamfer"]
    },
    {
      "contour_role_id": "ridge_contour",
      "plain_name": "ridge contour",
      "purpose": "Marks raised bands such as brow, cheekbone, lip, or chin relief.",
      "compatible_shape_terms": ["ridge", "relief", "bevel", "chamfer"]
    },
    {
      "contour_role_id": "socket_contour",
      "plain_name": "socket contour",
      "purpose": "Marks enclosed depressions such as eye sockets or ear anchors.",
      "compatible_shape_terms": ["socket", "valley", "bevel"]
    },
    {
      "contour_role_id": "valley_contour",
      "plain_name": "valley contour",
      "purpose": "Marks mouth crease, under-lip shadow, and other narrow recesses.",
