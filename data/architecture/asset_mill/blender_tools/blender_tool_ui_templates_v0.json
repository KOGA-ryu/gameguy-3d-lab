{
  "schema": "blender_tool_ui_templates_v0",
  "template_id": "blank_tool_plan_ui_templates_v0",
  "purpose": "Machine-readable compact UI control templates for the executable Blender tool-plan adapter tools.",
  "source_tool_dictionary": "data/architecture/asset_mill/blender_tools/blender_tool_dictionary_v0.json",
  "executor_script": "scripts/execute_blender_tool_plan_v0.py",
  "plan_schema": "gameguy_tool_plan_v0",
  "rules": {
    "templates_cover_executor_supported_tools": true,
    "templates_only_cover_executable_tools": true,
    "ui_writes_step_params_only": true,
    "step_order_and_stage_are_ui_owned": true,
    "blender_execution_requires_final_object": true
  },
  "stage_order": [
    "base_form",
    "assembly",
    "shape_refinement",
    "sculpt_detail",
    "retopo_cleanup",
    "uv_mapping",
    "material_texture",
    "validation_export"
  ],
  "control_kinds": [
    "boolean",
    "enum",
    "integer",
    "json_array",
    "json_object",
    "material_map",
    "number",
    "object_alias",
    "object_alias_list",
    "string",
    "vector3"
  ],
  "readiness_rules": [
    {
      "rule_id": "requires_visible_geometry",
      "message": "At least one visible geometry step is required before Blender execution."
    },
    {
      "rule_id": "requires_join_objects_for_final_object",
      "message": "A join_objects step is required before final-object modifiers, validation, render, or export."
    },
    {
      "rule_id": "requires_bounds_before_collision_proxy",
      "message": "calculate_bounds must run before create_collision_proxy."
    },
    {
      "rule_id": "render_and_export_are_explicit",
      "message": "render_workbench_preview and export_gltf are skipped unless the user explicitly runs with render/export enabled."
    }
  ],
