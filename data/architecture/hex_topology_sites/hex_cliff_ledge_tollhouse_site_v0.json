  "elevation_model": {
    "model_type": "rule_bands_v0",
    "base_rules": [
      {
        "rule_id": "lower_basin",
        "condition": "y < -7.0",
        "elevation": 0.0,
        "terrain_role": "lower_basin",
        "semantic_tags": ["walkable", "low_ground", "route_pressure"]
      },
      {
        "rule_id": "lower_terrace",
        "condition": "-7.0 <= y < -5.6",
        "elevation": 1.0,
        "terrain_role": "terrace",
        "semantic_tags": ["walkable", "restricted_route"]
      },
      {
        "rule_id": "upper_ledge",
