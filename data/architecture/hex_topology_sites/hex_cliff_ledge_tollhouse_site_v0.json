        "elevation": 2.0,
        "terrain_role": "ledge",
        "semantic_tags": ["walkable", "fall_edge", "restricted_route"]
      },
      {
        "rule_id": "upper_plateau",
        "condition": "y >= -4.1",
        "elevation": 3.0,
        "terrain_role": "plateau",
        "semantic_tags": ["walkable", "height_advantage", "buildable_site"]
      }
    ],
    "overrides": [
      {
