        "terrain_role": "road",
        "semantic_tags": ["walkable", "route", "approach_vector"]
      },
      {
        "override_id": "building_pad",
        "condition": "abs(x) <= 3.7 and -3.4 <= y <= 1.4",
        "elevation": 3.0,
        "terrain_role": "buildable_pad",
        "semantic_tags": ["walkable", "buildable_site", "height_advantage"]
      },
      {
        "override_id": "ledge_path",
        "condition": "abs(x) <= 4.4 and -5.1 <= y < -4.1",
        "elevation": 2.5,
        "terrain_role": "narrow_ledge",
        "semantic_tags": ["walkable", "fall_edge", "restricted_route"]
      }
    ]
  },
  "building_placement": {
