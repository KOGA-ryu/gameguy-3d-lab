      "contents": "achilles, patellar, biceps, finger tendons, joint ligaments"
    },
    {
      "layer": "07_fascia_aponeurosis",
      "role": "membrane network",
      "contents": "thoracolumbar fascia, palmar/plantar fascia, abdominal aponeurosis"
