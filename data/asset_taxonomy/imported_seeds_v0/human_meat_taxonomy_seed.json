    {
      "layer": "08_fat_pads_soft_tissue",
      "role": "cushion and silhouette",
      "contents": "cheeks, palms, heels, knees, elbows, abdomen, breast/chest fat"
    },
    {
      "layer": "09_skin_surface",
      "role": "outer mesh and deformation masks",
      "contents": "skin shell, pores/scars optional, wrinkle drivers"
    },
    {
      "layer": "10_external_layers",
      "role": "hair, nails, clothing, armor",
      "contents": "not anatomy core but attaches to skin/bone landmarks"
    }
  ],
