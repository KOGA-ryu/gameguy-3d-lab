      "used_for": "fat pads, cheek pads, pectoral sheets, glute planes"
    },
    {
      "shape_type": "fan_sheet",
      "geometry_meaning": "triangular/radial surface",
      "used_for": "pectoralis, temporalis, latissimus, adductors"
    },
    {
      "shape_type": "strap_ribbon",
      "geometry_meaning": "long flat strip",
      "used_for": "sartorius, sternocleidomastoid, gracilis, tendinous straps"
    },
    {
      "shape_type": "layered_sheet",
      "geometry_meaning": "stacked membranes",
      "used_for": "fascia, abdominal wall, scalp layers, intercostals"
    },
    {
      "shape_type": "ring_band",
      "geometry_meaning": "torus/loop band",
      "used_for": "eye, mouth, sphincter, joint rim, retinaculum loops"
    },
    {
      "shape_type": "cord_curve",
      "geometry_meaning": "bezier curve with bevel depth",
      "used_for": "tendons, ligaments, nerves, vessels"
    },
    {
      "shape_type": "branch_curve_tree",
      "geometry_meaning": "branching curves",
      "used_for": "vascular and nerve maps"
    },
    {
      "shape_type": "hollow_shell",
      "geometry_meaning": "surface shell with thickness",
      "used_for": "skin, organ cavities, skull/torso cavities"
    },
    {
      "shape_type": "coil_tube",
      "geometry_meaning": "coiled tube path",
      "used_for": "intestines, vessels, ducts"
    },
    {
      "shape_type": "lobe_stack",
      "geometry_meaning": "cluster of ellipsoids",
      "used_for": "brain lobes, liver lobes, lung lobes, gland groups"
    },
    {
      "shape_type": "hinge_constraint_proxy",
      "geometry_meaning": "non-rendered rig empty/axis",
      "used_for": "knees, elbows, fingers, toes, jaw"
    },
    {
      "shape_type": "ball_socket_proxy",
      "geometry_meaning": "sphere center + rotation limits",
      "used_for": "shoulders, hips, neck/head"
    },
    {
      "shape_type": "sliding_track_proxy",
      "geometry_meaning": "guided curve/rail",
      "used_for": "patella tracking, scapula glide, tendon sheaths"
    },
    {
      "shape_type": "surface_driver_patch",
      "geometry_meaning": "deformation mask area",
      "used_for": "skin wrinkles, muscle bulges, fascia tension"
    }
