  "layers": [
    {
      "layer": "00_root_scale",
      "role": "global proportions and landmarks",
      "contents": "height, head count, symmetry plane, handedness"
    },
    {
      "layer": "01_bones",
      "role": "hard landmarks",
      "contents": "already started in bone spec; bones define anchors"
    },
    {
      "layer": "02_joint_law",
      "role": "movement law",
      "contents": "joint centers, axes, rotation limits, collisions"
    },
    {
      "layer": "03_deep_organs",
      "role": "internal masses",
      "contents": "brain, eyes, lungs, heart, liver, digestive coil, kidneys, bladder"
    },
    {
      "layer": "04_deep_muscle",
      "role": "deep stabilizers",
      "contents": "rotator cuff, hip rotators, intercostals, pelvic floor, intrinsic spine"
    },
    {
      "layer": "05_surface_muscle",
      "role": "visible meat volumes",
      "contents": "pecs, delts, arms, glutes, quads, calves, face"
    },
    {
      "layer": "06_tendons_ligaments",
