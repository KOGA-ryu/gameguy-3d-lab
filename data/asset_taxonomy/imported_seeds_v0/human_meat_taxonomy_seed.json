      "used_for": "arms, legs, forearms, calves, neck straps"
    },
    {
      "shape_type": "ellipsoid",
      "geometry_meaning": "scaled sphere/oval",
      "used_for": "organs, pads, muscle bulges, glands, lobes"
    },
    {
