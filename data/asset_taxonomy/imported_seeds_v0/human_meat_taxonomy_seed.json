  "assembly_rules": [
    {
      "rule": "name_everything",
      "implementation_note": "Every generated object gets a stable lowercase proxy name."
    },
    {
      "rule": "never_boolean_first",
      "implementation_note": "Do not begin with boolean-carved masterpiece meshes. Build proxies first, then refine."
    },
    {
      "rule": "keep_layers_hideable",
      "implementation_note": "Bones, muscles, organs, tendons, fascia, fat, skin, nerves, vessels must be independent collections."
    },
    {
      "rule": "anchors_over_vibes",
      "implementation_note": "Every part must declare anchor landmarks before geometry exists."
    },
    {
      "rule": "shape_type_required",
      "implementation_note": "Every part must have a shape type so Python can choose the builder."
    },
    {
      "rule": "left_right_mirroring",
      "implementation_note": "Use l_ and r_ naming; generate one side and mirror when possible."
    },
    {
      "rule": "deformation_later",
      "implementation_note": "First generate static volumes, then add rigging constraints and shape keys."
    },
    {
      "rule": "hero_detail_last",
      "implementation_note": "Micro texture and sculpt detail come after proportions, or the project becomes a decorative swamp."
    }
  ]
}