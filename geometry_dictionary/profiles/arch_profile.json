  "common_uses": ["door opening", "window opening", "niche", "portal frame"],
  "blender_method": "generate jamb points and top arc/point curve, then extrude or use as boolean cutter",
  "validation": ["closed_profile", "nonzero_area", "profile_has_no_self_intersections"]
}
